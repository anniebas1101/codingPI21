#include <iostream>
using namespace std;

struct Para {
    int first;   // номинал купюры
    int second;  // количество купюр
};

void init(Para &p, int f, int s) {
    // Проверка допустимых номиналов
    int valid[] = {1, 2, 5, 10, 50, 100, 500, 1000, 5000};
    bool ok = false;
    
    for (int i = 0; i < 9; i++) {
        if (f == valid[i]) {
            ok = true;
            break;
        }
    }
    
    if (!ok) {
        cout << "Ошибка: недопустимый номинал!" << endl;
        exit(1);
    }
    
    if (s <= 0) {
        cout << "Ошибка: количество должно быть > 0!" << endl;
        exit(1);
    }
    
    p.first = f;
    p.second = s;
}

void read(Para &p) {
    cout << "Номинал (1,2,5,10,50,100,500,1000,5000): ";
    cin >> p.first;
    
    int valid[] = {1, 2, 5, 10, 50, 100, 500, 1000, 5000};
    bool ok = false;
    
    for (int i = 0; i < 9; i++) {
        if (p.first == valid[i]) {
            ok = true;
            break;
        }
    }
    
    if (!ok) {
        cout << "Ошибка: недопустимый номинал!" << endl;
        exit(1);
    }
    
    cout << "Количество: ";
    cin >> p.second;
    
    if (p.second <= 0) {
        cout << "Ошибка: количество должно быть > 0!" << endl;
        exit(1);
    }
}

void display(const Para &p) {
    cout << "Номинал: " << p.first << ", Кол-во: " << p.second;
}

int summa(const Para &p) {
    return p.first * p.second;
}

Para make_para(int f, int s) {
    Para p;
    init(p, f, s);
    return p;
}

int main() {
    // 1. Создание через init
    Para x;
    x.first = 100;
    x.second = 5;
    cout << "1. Простое создание:" << endl;
    display(x);
    cout << ", Сумма: " << summa(x) << endl << endl;
    
    // 2. Создание через функцию init
    Para y;
    init(y, 500, 3);
    cout << "2. Через init:" << endl;
    display(y);
    cout << ", Сумма: " << summa(y) << endl << endl;
    
    // 3. Ввод с клавиатуры
    Para z;
    cout << "3. Ввод с клавиатуры:" << endl;
    read(z);
    cout << "Введено: ";
    display(z);
    cout << ", Сумма: " << summa(z) << endl << endl;
    
    // 4. Через make_para
    Para w = make_para(1000, 2);
    cout << "4. Через make_para:" << endl;
    display(w);
    cout << ", Сумма: " << summa(w) << endl << endl;
    
    // 5. Массив объектов
    Para arr[2];
    arr[0] = make_para(10, 20);
    arr[1] = make_para(50, 10);
    
    cout << "5. Массив объектов:" << endl;
    for (int i = 0; i < 2; i++) {
        cout << "arr[" << i << "]: ";
        display(arr[i]);
        cout << ", Сумма: " << summa(arr[i]) << endl;
    }
    
    return 0;
}
